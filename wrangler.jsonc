{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escp-venture-simulator",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-08",
  "containers": [
    {
      "class_name": "VentureSimulator",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "VENTURE_SIMULATOR",
        "class_name": "VentureSimulator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VentureSimulator"]
    }
  ],
  "routes": [
    {
      "pattern": "venturesimulator.actscal.org",
      "custom_domain": true
    }
  ]
}
